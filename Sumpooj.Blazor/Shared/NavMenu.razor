@using Microsoft.AspNetCore.Components.Authorization
@using Sumpooj.Blazor.Auth
@using Sumpooj.Blazor.Services
@inject AuthenticationStateProvider AuthState
@inject ITokenStorage TokenStorage
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="customers">
                Customers
            </NavLink>
        </li>

        <li class="nav-item px-3">
            <button class="btn btn-link nav-link"
                    @onclick="Logout">
                Logout
            </button>
        </li>
    </Authorized>

    <NotAuthorized>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="/auth/login">
                Login
            </NavLink>
        </li>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task Logout()
    {
        await TokenStorage.ClearAsync();

        if (AuthState is JwtAuthenticationStateProvider prov)
            prov.NotifyUserLogout();

        Nav.NavigateTo("/auth/login", true);
    }
}
