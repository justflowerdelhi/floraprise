@page "/login"
@inject OwnerAuthService AuthService
@inject NavigationManager Navigation

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div class="brand-mark"></div>
            <div>
                <h1 class="brand-title">Floraprise</h1>
                <p class="brand-subtitle">Owner Control Center</p>
            </div>
        </div>

        <div class="login-form">
            <MudTextField T="string" Label="Password" Variant="Variant.Outlined" @bind-Value="_password" Type="InputType.Password" Class="form-field" />
            <MudTextField T="string" Label="Secret Security Code" Variant="Variant.Outlined" @bind-Value="_secretCode" Type="InputType.Password" Class="form-field" />

            <MudCheckBox T="bool" Label="Remember this computer" @bind-Value="_rememberDevice" Class="remember-checkbox" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth OnClick="HandleLogin" Class="login-button">Login</MudButton>
        </div>

        <div class="login-footer">
            <span>Version 2.0</span>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f7fa;
        padding: 24px;
    }

    .login-card {
        background: #ffffff;
        border: 1px solid #e6ebf1;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        width: 100%;
        max-width: 500px;
        padding: 32px;
    }

    .login-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .brand-mark {
        width: 12px;
        height: 36px;
        border-radius: 999px;
        background: linear-gradient(135deg, #2e7d32, #66bb6a);
    }

    .brand-title {
        font-size: 20px;
        font-weight: 700;
        color: #243447;
        margin: 0;
    }

    .brand-subtitle {
        font-size: 13px;
        color: #6b7280;
        margin: 2px 0 0;
    }

    .form-field {
        margin-bottom: 16px;
    }

    .remember-checkbox {
        margin-bottom: 20px;
    }

    .login-button {
        height: 44px;
        font-weight: 600;
        font-size: 14px;
        background: #2e7d32;
        text-transform: none;
    }

    .login-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 12px;
        color: #8a94a6;
    }
</style>

@code {
    private string _password = string.Empty;
    private string _secretCode = string.Empty;
    private bool _rememberDevice = false;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void HandleLogin()
    {
        if (AuthService.Login(_password, _secretCode))
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Console.WriteLine("Invalid credentials");
        }
    }
}
