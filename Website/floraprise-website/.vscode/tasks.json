{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Next.js Dev Server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Build Next.js App",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Install Next.js",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"next"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build Next.js App",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Install All Dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build Next.js App",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Install All Dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build Next.js App",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Delete node_modules",
			"type": "shell",
			"command": "rmdir",
			"args": [
				"/s",
				"/q",
				"node_modules"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Delete package-lock.json",
			"type": "shell",
			"command": "del",
			"args": [
				"package-lock.json"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Build Next.js app",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Run Next.js Development Server",
			"type": "shell",
			"command": "npm run dev",
			"args": [],
			"isBackground": true,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}